#!/bin/bash

# Configuration
TARGET='/www/wwwroot/voice.frolax.agency'
GIT_DIR='/www/repos/voice.git'
BRANCH='main'
PHP_BIN='/www/server/php/85/bin/php'
COMPOSER_BIN='/usr/bin/composer'
NODE_PATH='/www/server/nodejs/v24.12.0/bin'

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

# Set Node.js PATH
export PATH="$NODE_PATH:$PATH"

# Logging functions
LOG_INFO() { echo -e "${BLUE}$1${NC}"; }
LOG_SUCCESS() { echo -e "${GREEN}$1${NC}"; }
LOG_WARNING() { echo -e "${YELLOW}$1${NC}"; }
LOG_ERROR() { echo -e "${RED}$1${NC}"; }

# Run artisan command as www user in target directory
artisan() {
    sudo -u www "$PHP_BIN"  -d memory_limit=512M "$TARGET/artisan" "$@"
}

# Error handling
set -e
trap 'handle_error $?' ERR

handle_error() {
    local exit_code=$1
    LOG_ERROR "Deployment failed with exit code: $exit_code"
    LOG_WARNING "Attempting to bring application back online..."
    artisan up 2>/dev/null || true
    exit "$exit_code"
}

# Deploy function
deploy() {
    LOG_WARNING "Deploying $BRANCH branch to production..."

    # Checkout code
    sudo git --work-tree="$TARGET" --git-dir="$GIT_DIR" checkout -f "$BRANCH"

    # Fix permissions
    sudo find "$TARGET" \( -path '*/vendor' -o -path '*/vendor/*' \) -prune -o -not -name '.user.ini' -print0 | xargs -0 sudo chown www:www


    cd "$TARGET" || exit 1

    # === Deployment steps ===

    LOG_INFO "Installing composer dependencies..."
    sudo -u www "$PHP_BIN" "$COMPOSER_BIN" install --quiet
    #--no-interaction --prefer-dist --optimize-autoloader --no-dev --quiet

    LOG_INFO "Enabling maintenance mode..."
    artisan down --retry=60 --secret=bishwajit

    LOG_INFO "Installing node dependencies..."
    pnpm install

    LOG_INFO "Building vite application"
    pnpm build

    LOG_INFO "Clearing Laravel caches..."
    artisan optimize:clear

    LOG_INFO "Running database migrations..."
    artisan migrate --force --no-interaction

    LOG_INFO "Optimizing Laravel..."
    artisan optimize

    LOG_INFO "Restart Reverb"
    artisan reverb:restart

    LOG_INFO "Terminate Horizon"
    artisan horizon:terminate

    LOG_INFO "Restart Asterisk"
    artisan asterisk:restart

    LOG_INFO "Reload Octane"
    artisan octane:reload

    LOG_INFO "Disabling maintenance mode..."
    artisan up

    LOG_INFO "Build API documentation"
    artisan scribe:generate --quiet

    LOG_SUCCESS "✓ Deployment completed successfully!"
}

# Main loop
# shellcheck disable=SC2034
while read -r oldrev newrev ref; do
    if [[ $ref == "refs/heads/$BRANCH" ]]; then
        deploy
    else
        LOG_ERROR "Ref $ref received. Doing nothing: only the $BRANCH branch may be deployed on this server."
    fi
done
